{
  "name": "sf-teamflow",
  "displayName": "Salesforce Dev Manager",
  "description": "これ1つでSalesforce開発サイクルを完結。Org/環境管理・各環境への簡単デプロイ(開発→ステージング→本番)・Git/GitHub・テスト・CI/CDを、初心者でもクリック操作で。",
  "version": "0.49.0",
  "publisher": "akira-kataoka",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers",
    "Snippets"
  ],
  "keywords": [
    "salesforce",
    "sfdx",
    "sf cli",
    "ci/cd",
    "devops",
    "team"
  ],
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/akira-kataoka/sf-teamflow.git"
  },
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:sfdx-project.json",
    "workspaceContains:sf-teamflow.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sf-teamflow",
          "title": "Salesforce Dev Manager",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "sf-teamflow": [
        {
          "id": "teamflow.home",
          "name": "ホーム",
          "type": "webview",
          "icon": "resources/activitybar.svg"
        },
        {
          "id": "teamflow.orgs",
          "name": "環境詳細",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "teamflow.gettingStarted",
        "title": "Salesforce Dev Manager ではじめるチーム開発",
        "description": "プロジェクト作成からOrg認証・環境設定・CI/CD・バックアップまで、順番に進めましょう。",
        "steps": [
          {
            "id": "project",
            "title": "プロジェクトを準備する",
            "description": "新しいSFDXプロジェクトを作るか、既存のフォルダを開きます。\n[新しいプロジェクトを作成](command:teamflow.createProject)",
            "media": { "markdown": "media/walkthrough/project.md" }
          },
          {
            "id": "auth",
            "title": "Orgを認証する",
            "description": "開発・ステージング・本番などのOrgにログインします。\n[Orgを認証](command:teamflow.authorizeOrg)",
            "media": { "markdown": "media/walkthrough/auth.md" }
          },
          {
            "id": "config",
            "title": "チーム設定を作る",
            "description": "環境⇔ブランチ⇔Orgの対応を定義します (sf-teamflow.json)。\n[チーム設定を初期化](command:teamflow.initTeamProject)",
            "media": { "markdown": "media/walkthrough/config.md" }
          },
          {
            "id": "cicd",
            "title": "CI/CDを生成する",
            "description": "PR検証とデプロイのGitHub Actionsを自動生成します。\n[CI/CDを生成](command:teamflow.scaffoldCICD)",
            "media": { "markdown": "media/walkthrough/cicd.md" }
          },
          {
            "id": "backup",
            "title": "保存してバックアップする",
            "description": "変更をコミットしてGitHubに安全に保管します。\n[保存してバックアップ](command:teamflow.gitCommitPush)\n\n複数人開発の進め方は [ガイド](command:teamflow.openWorkflowGuide) を参照。",
            "media": { "markdown": "media/walkthrough/backup.md" }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "teamflow.refreshOrgs",
        "title": "SFDevManager: 環境(Org)一覧を更新",
        "icon": "$(refresh)"
      },
      {
        "command": "teamflow.authorizeOrg",
        "title": "SFDevManager: 新しい環境(Org)を認証",
        "icon": "$(add)"
      },
      {
        "command": "teamflow.setDefaultOrg",
        "title": "SFDevManager: この環境(Org)を既定に設定",
        "icon": "$(star)"
      },
      {
        "command": "teamflow.openOrg",
        "title": "SFDevManager: ブラウザで環境(Org)を開く",
        "icon": "$(globe)"
      },
      {
        "command": "teamflow.logoutOrg",
        "title": "SFDevManager: 環境(Org)の認証を解除",
        "icon": "$(sign-out)"
      },
      {
        "command": "teamflow.reconnectOrg",
        "title": "SFDevManager: この環境(Org)に再接続",
        "icon": "$(debug-restart)"
      },
      {
        "command": "teamflow.copyOrgId",
        "title": "SFDevManager: 環境(Org) IDをコピー"
      },
      {
        "command": "teamflow.deployDiff",
        "title": "SFDevManager: Git差分をデプロイ",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "teamflow.validateDiff",
        "title": "SFDevManager: Git差分を検証 (デプロイなし)",
        "icon": "$(verified)"
      },
      {
        "command": "teamflow.previewDiff",
        "title": "SFDevManager: デプロイ対象の差分をプレビュー",
        "icon": "$(diff)"
      },
      {
        "command": "teamflow.deployToEnvironment",
        "title": "SFDevManager: 環境を選んでデプロイ（開発/ステージング/本番）",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "teamflow.scaffoldCICD",
        "title": "SFDevManager: CI/CD (GitHub Actions) を生成",
        "icon": "$(rocket)"
      },
      {
        "command": "teamflow.initTeamProject",
        "title": "SFDevManager: チーム開発プロジェクトを初期化",
        "icon": "$(repo)"
      },
      {
        "command": "teamflow.openConfig",
        "title": "SFDevManager: チーム設定 (sf-teamflow.json) を開く",
        "icon": "$(settings-gear)"
      },
      {
        "command": "teamflow.setupDevHub",
        "title": "SFDevManager: Dev Hub を準備（スクラッチ組織の親組織）",
        "icon": "$(server-environment)"
      },
      {
        "command": "teamflow.createScratchOrg",
        "title": "SFDevManager: スクラッチ環境(Org)を作成",
        "icon": "$(beaker)"
      },
      {
        "command": "teamflow.deleteScratchOrg",
        "title": "SFDevManager: スクラッチ環境(Org)を削除",
        "icon": "$(trash)"
      },
      {
        "command": "teamflow.createProject",
        "title": "SFDevManager: 新しいプロジェクトを作成",
        "icon": "$(repo-create)"
      },
      {
        "command": "teamflow.createComponent",
        "title": "SFDevManager: 新しいコンポーネントを作成（Apex/LWC/Aura）",
        "icon": "$(file-add)"
      },
      {
        "command": "teamflow.createPullRequest",
        "title": "SFDevManager: Pull Requestを作成",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "teamflow.retrieveMetadata",
        "title": "SFDevManager: メタデータを取得",
        "icon": "$(cloud-download)"
      },
      {
        "command": "teamflow.retrieveByManifest",
        "title": "SFDevManager: manifest (package.xml) でメタデータを取得",
        "icon": "$(file-code)"
      },
      {
        "command": "teamflow.sourcePush",
        "title": "SFDevManager: 環境(Org)に反映 (push・全部/資材選択)",
        "icon": "$(arrow-up)"
      },
      {
        "command": "teamflow.sourcePull",
        "title": "SFDevManager: 環境(Org)から取り込み (pull)",
        "icon": "$(arrow-down)"
      },
      {
        "command": "teamflow.runTests",
        "title": "SFDevManager: Apexテストを実行",
        "icon": "$(beaker)"
      },
      {
        "command": "teamflow.pushAndTest",
        "title": "SFDevManager: 環境(Org)へ反映してテスト",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "teamflow.tailLog",
        "title": "SFDevManager: デバッグログを確認（リアルタイム）",
        "icon": "$(output)"
      },
      {
        "command": "teamflow.guidedSetup",
        "title": "SFDevManager: ガイド付きセットアップ",
        "icon": "$(checklist)"
      },
      {
        "command": "teamflow.setupWizard",
        "title": "SFDevManager: 環境セットアップウィザード（開発/ステージング/本番）",
        "icon": "$(server-environment)"
      },
      {
        "command": "teamflow.openWorkflowGuide",
        "title": "SFDevManager: チーム開発ガイドを開く",
        "icon": "$(book)"
      },
      {
        "command": "teamflow.quickSettings",
        "title": "SFDevManager: 設定（テストレベル/本番確認）",
        "icon": "$(gear)"
      },
      {
        "command": "teamflow.gitCommitPush",
        "title": "SFDevManager: 保存してバックアップ (commit & push)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "teamflow.gitSync",
        "title": "SFDevManager: GitHubと同期 (pull & push)",
        "icon": "$(sync)"
      },
      {
        "command": "teamflow.gitNewBranch",
        "title": "SFDevManager: 作業ブランチを作成 / 切り替え",
        "icon": "$(git-branch)"
      },
      {
        "command": "teamflow.gitPublish",
        "title": "SFDevManager: GitHubに公開",
        "icon": "$(github)"
      },
      {
        "command": "teamflow.manageBranches",
        "title": "SFDevManager: ブランチを管理（切替/作成/削除）",
        "icon": "$(git-branch)"
      },
      {
        "command": "teamflow.createTag",
        "title": "SFDevManager: リリースタグを作成",
        "icon": "$(tag)"
      },
      {
        "command": "teamflow.manageTags",
        "title": "SFDevManager: タグを管理（作成/プッシュ/削除）",
        "icon": "$(tag)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "teamflow.quickSettings",
          "when": "view == teamflow.home",
          "group": "navigation@1"
        },
        {
          "command": "teamflow.refreshOrgs",
          "when": "view == teamflow.home",
          "group": "navigation@2"
        },
        {
          "command": "teamflow.refreshOrgs",
          "when": "view == teamflow.orgs",
          "group": "navigation@1"
        },
        {
          "command": "teamflow.authorizeOrg",
          "when": "view == teamflow.orgs",
          "group": "navigation@2"
        },
        {
          "command": "teamflow.setupWizard",
          "when": "view == teamflow.orgs",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "teamflow.setDefaultOrg",
          "when": "view == teamflow.orgs && viewItem =~ /^teamflow.org/",
          "group": "inline@1"
        },
        {
          "command": "teamflow.openOrg",
          "when": "view == teamflow.orgs && viewItem =~ /^teamflow.org/",
          "group": "inline@2"
        },
        {
          "command": "teamflow.reconnectOrg",
          "when": "view == teamflow.orgs && viewItem == teamflow.orgDisconnected",
          "group": "inline@0"
        },
        {
          "command": "teamflow.reconnectOrg",
          "when": "view == teamflow.orgs && viewItem == teamflow.orgDisconnected",
          "group": "0_reconnect@1"
        },
        {
          "command": "teamflow.setDefaultOrg",
          "when": "view == teamflow.orgs && viewItem =~ /^teamflow.org/",
          "group": "1_actions@1"
        },
        {
          "command": "teamflow.openOrg",
          "when": "view == teamflow.orgs && viewItem =~ /^teamflow.org/",
          "group": "1_actions@2"
        },
        {
          "command": "teamflow.copyOrgId",
          "when": "view == teamflow.orgs && viewItem =~ /^teamflow.org/",
          "group": "1_actions@3"
        },
        {
          "command": "teamflow.sourcePush",
          "when": "view == teamflow.orgs && viewItem =~ /^teamflow.org/",
          "group": "2_source@1"
        },
        {
          "command": "teamflow.sourcePull",
          "when": "view == teamflow.orgs && viewItem =~ /^teamflow.org/",
          "group": "2_source@2"
        },
        {
          "command": "teamflow.retrieveMetadata",
          "when": "view == teamflow.orgs && viewItem =~ /^teamflow.org/",
          "group": "2_source@3"
        },
        {
          "command": "teamflow.logoutOrg",
          "when": "view == teamflow.orgs && viewItem =~ /^teamflow.org/",
          "group": "9_danger@1"
        },
        {
          "command": "teamflow.deleteScratchOrg",
          "when": "view == teamflow.orgs && viewItem =~ /^teamflow.org/",
          "group": "9_danger@2"
        }
      ],
      "commandPalette": [
        {
          "command": "teamflow.setDefaultOrg",
          "when": "false"
        },
        {
          "command": "teamflow.openOrg",
          "when": "false"
        },
        {
          "command": "teamflow.logoutOrg",
          "when": "false"
        },
        {
          "command": "teamflow.copyOrgId",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "SF TeamFlow",
      "properties": {
        "teamflow.deploy.baseRef": {
          "type": "string",
          "default": "origin/main",
          "description": "Git差分デプロイの基準となるref (例: origin/main, develop)。sf-teamflow.json の環境設定があればそちらが優先されます。"
        },
        "teamflow.deploy.testLevel": {
          "type": "string",
          "enum": [
            "NoTestRun",
            "RunSpecifiedTests",
            "RunLocalTests",
            "RunAllTestsInOrg"
          ],
          "default": "RunLocalTests",
          "description": "デプロイ/検証時のApexテストレベル。"
        },
        "teamflow.confirmProductionDeploy": {
          "type": "boolean",
          "default": true,
          "description": "本番Orgへのデプロイ前に確認ダイアログを表示する。"
        },
        "teamflow.sfCliPath": {
          "type": "string",
          "default": "sf",
          "description": "Salesforce CLI (sf) の実行パス。PATHが通っていない場合に絶対パスを指定。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "test": "node --test out-test/test",
    "compile-test": "tsc -p tsconfig.test.json",
    "pretest": "npm run compile-test",
    "lint": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
