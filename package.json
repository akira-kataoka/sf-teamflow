{
  "name": "sf-teamflow",
  "displayName": "SF TeamFlow — Salesforce Team Dev Orchestrator",
  "description": "Salesforce チーム開発を「環境 / Git / CI/CD」で体系化する VSCode 拡張。Org 環境マネージャ・Git 差分デプロイ・GitHub Actions スキャフォルドをワンストップで提供します。",
  "version": "0.7.0",
  "publisher": "akira-kataoka",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers",
    "Snippets"
  ],
  "keywords": [
    "salesforce",
    "sfdx",
    "sf cli",
    "ci/cd",
    "devops",
    "team"
  ],
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/akira-kataoka/sf-teamflow.git"
  },
  "activationEvents": [
    "workspaceContains:sfdx-project.json",
    "workspaceContains:sf-teamflow.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sf-teamflow",
          "title": "SF TeamFlow",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "sf-teamflow": [
        {
          "id": "teamflow.home",
          "name": "ホーム",
          "type": "webview",
          "icon": "resources/activitybar.svg"
        },
        {
          "id": "teamflow.orgs",
          "name": "Orgs / 環境",
          "icon": "resources/activitybar.svg"
        },
        {
          "id": "teamflow.environments",
          "name": "チーム環境",
          "icon": "resources/activitybar.svg"
        },
        {
          "id": "teamflow.git",
          "name": "バックアップ (Git)",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "teamflow.git",
        "contents": "まだバージョン管理(Git)が始まっていません。\n\nバージョン管理を使うと、作業のバックアップ・履歴・チーム共同作業が安全にできます。\n\n[ガイド付きセットアップ](command:teamflow.guidedSetup)\n[GitHubに公開する](command:teamflow.gitPublish)\n\nチーム開発の進め方は [ガイドを開く](command:teamflow.openWorkflowGuide) で確認できます。"
      }
    ],
    "walkthroughs": [
      {
        "id": "teamflow.gettingStarted",
        "title": "SF TeamFlow ではじめる Salesforce チーム開発",
        "description": "プロジェクト作成からOrg認証・環境設定・CI/CD・バックアップまで、順番に進めましょう。",
        "steps": [
          {
            "id": "project",
            "title": "プロジェクトを準備する",
            "description": "新しいSFDXプロジェクトを作るか、既存のフォルダを開きます。\n[新しいプロジェクトを作成](command:teamflow.createProject)",
            "media": { "markdown": "media/walkthrough/project.md" }
          },
          {
            "id": "auth",
            "title": "Orgを認証する",
            "description": "開発・ステージング・本番などのOrgにログインします。\n[Orgを認証](command:teamflow.authorizeOrg)",
            "media": { "markdown": "media/walkthrough/auth.md" }
          },
          {
            "id": "config",
            "title": "チーム設定を作る",
            "description": "環境⇔ブランチ⇔Orgの対応を定義します (sf-teamflow.json)。\n[チーム設定を初期化](command:teamflow.initTeamProject)",
            "media": { "markdown": "media/walkthrough/config.md" }
          },
          {
            "id": "cicd",
            "title": "CI/CDを生成する",
            "description": "PR検証とデプロイのGitHub Actionsを自動生成します。\n[CI/CDを生成](command:teamflow.scaffoldCICD)",
            "media": { "markdown": "media/walkthrough/cicd.md" }
          },
          {
            "id": "backup",
            "title": "保存してバックアップする",
            "description": "変更をコミットしてGitHubに安全に保管します。\n[保存してバックアップ](command:teamflow.gitCommitPush)\n\n複数人開発の進め方は [ガイド](command:teamflow.openWorkflowGuide) を参照。",
            "media": { "markdown": "media/walkthrough/backup.md" }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "teamflow.refreshOrgs",
        "title": "TeamFlow: Org一覧を更新",
        "icon": "$(refresh)"
      },
      {
        "command": "teamflow.authorizeOrg",
        "title": "TeamFlow: 新しいOrgを認証",
        "icon": "$(add)"
      },
      {
        "command": "teamflow.setDefaultOrg",
        "title": "TeamFlow: このOrgを既定に設定",
        "icon": "$(star)"
      },
      {
        "command": "teamflow.openOrg",
        "title": "TeamFlow: ブラウザでOrgを開く",
        "icon": "$(globe)"
      },
      {
        "command": "teamflow.logoutOrg",
        "title": "TeamFlow: Orgの認証を解除",
        "icon": "$(sign-out)"
      },
      {
        "command": "teamflow.copyOrgId",
        "title": "TeamFlow: Org IDをコピー"
      },
      {
        "command": "teamflow.deployDiff",
        "title": "TeamFlow: Git差分をデプロイ",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "teamflow.validateDiff",
        "title": "TeamFlow: Git差分を検証 (デプロイなし)",
        "icon": "$(verified)"
      },
      {
        "command": "teamflow.previewDiff",
        "title": "TeamFlow: デプロイ対象の差分をプレビュー",
        "icon": "$(diff)"
      },
      {
        "command": "teamflow.scaffoldCICD",
        "title": "TeamFlow: CI/CD (GitHub Actions) を生成",
        "icon": "$(rocket)"
      },
      {
        "command": "teamflow.initTeamProject",
        "title": "TeamFlow: チーム開発プロジェクトを初期化",
        "icon": "$(repo)"
      },
      {
        "command": "teamflow.openConfig",
        "title": "TeamFlow: チーム設定 (sf-teamflow.json) を開く",
        "icon": "$(settings-gear)"
      },
      {
        "command": "teamflow.createScratchOrg",
        "title": "TeamFlow: スクラッチOrgを作成",
        "icon": "$(beaker)"
      },
      {
        "command": "teamflow.deleteScratchOrg",
        "title": "TeamFlow: スクラッチOrgを削除",
        "icon": "$(trash)"
      },
      {
        "command": "teamflow.createProject",
        "title": "TeamFlow: 新しいプロジェクトを作成",
        "icon": "$(repo-create)"
      },
      {
        "command": "teamflow.retrieveMetadata",
        "title": "TeamFlow: メタデータを取得",
        "icon": "$(cloud-download)"
      },
      {
        "command": "teamflow.retrieveByManifest",
        "title": "TeamFlow: manifest (package.xml) でメタデータを取得",
        "icon": "$(file-code)"
      },
      {
        "command": "teamflow.sourcePush",
        "title": "TeamFlow: Orgにソースを反映 (push)",
        "icon": "$(arrow-up)"
      },
      {
        "command": "teamflow.sourcePull",
        "title": "TeamFlow: Orgから変更を取り込み (pull)",
        "icon": "$(arrow-down)"
      },
      {
        "command": "teamflow.runTests",
        "title": "TeamFlow: Apexテストを実行",
        "icon": "$(beaker)"
      },
      {
        "command": "teamflow.pushAndTest",
        "title": "TeamFlow: Orgへ反映してテスト",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "teamflow.guidedSetup",
        "title": "TeamFlow: ガイド付きセットアップ",
        "icon": "$(checklist)"
      },
      {
        "command": "teamflow.setupWizard",
        "title": "TeamFlow: 環境セットアップウィザード（開発/ステージング/本番）",
        "icon": "$(server-environment)"
      },
      {
        "command": "teamflow.openWorkflowGuide",
        "title": "TeamFlow: チーム開発ガイドを開く",
        "icon": "$(book)"
      },
      {
        "command": "teamflow.gitCommitPush",
        "title": "TeamFlow: 保存してバックアップ (commit & push)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "teamflow.gitSync",
        "title": "TeamFlow: GitHubと同期 (pull & push)",
        "icon": "$(sync)"
      },
      {
        "command": "teamflow.gitNewBranch",
        "title": "TeamFlow: 作業ブランチを作成 / 切り替え",
        "icon": "$(git-branch)"
      },
      {
        "command": "teamflow.gitPublish",
        "title": "TeamFlow: GitHubに公開",
        "icon": "$(github)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "teamflow.refreshOrgs",
          "when": "view == teamflow.orgs",
          "group": "navigation@1"
        },
        {
          "command": "teamflow.authorizeOrg",
          "when": "view == teamflow.orgs",
          "group": "navigation@2"
        },
        {
          "command": "teamflow.guidedSetup",
          "when": "view == teamflow.orgs",
          "group": "navigation@3"
        },
        {
          "command": "teamflow.setupWizard",
          "when": "view == teamflow.environments",
          "group": "navigation@0"
        },
        {
          "command": "teamflow.openConfig",
          "when": "view == teamflow.environments",
          "group": "navigation@1"
        },
        {
          "command": "teamflow.scaffoldCICD",
          "when": "view == teamflow.environments",
          "group": "navigation@2"
        },
        {
          "command": "teamflow.openWorkflowGuide",
          "when": "view == teamflow.environments",
          "group": "navigation@3"
        },
        {
          "command": "teamflow.gitCommitPush",
          "when": "view == teamflow.git",
          "group": "navigation@1"
        },
        {
          "command": "teamflow.gitSync",
          "when": "view == teamflow.git",
          "group": "navigation@2"
        },
        {
          "command": "teamflow.gitNewBranch",
          "when": "view == teamflow.git",
          "group": "navigation@3"
        },
        {
          "command": "teamflow.refreshOrgs",
          "when": "view == teamflow.git",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "teamflow.setDefaultOrg",
          "when": "view == teamflow.orgs && viewItem == teamflow.org",
          "group": "inline@1"
        },
        {
          "command": "teamflow.openOrg",
          "when": "view == teamflow.orgs && viewItem == teamflow.org",
          "group": "inline@2"
        },
        {
          "command": "teamflow.setDefaultOrg",
          "when": "view == teamflow.orgs && viewItem == teamflow.org",
          "group": "1_actions@1"
        },
        {
          "command": "teamflow.openOrg",
          "when": "view == teamflow.orgs && viewItem == teamflow.org",
          "group": "1_actions@2"
        },
        {
          "command": "teamflow.copyOrgId",
          "when": "view == teamflow.orgs && viewItem == teamflow.org",
          "group": "1_actions@3"
        },
        {
          "command": "teamflow.sourcePush",
          "when": "view == teamflow.orgs && viewItem == teamflow.org",
          "group": "2_source@1"
        },
        {
          "command": "teamflow.sourcePull",
          "when": "view == teamflow.orgs && viewItem == teamflow.org",
          "group": "2_source@2"
        },
        {
          "command": "teamflow.retrieveMetadata",
          "when": "view == teamflow.orgs && viewItem == teamflow.org",
          "group": "2_source@3"
        },
        {
          "command": "teamflow.logoutOrg",
          "when": "view == teamflow.orgs && viewItem == teamflow.org",
          "group": "9_danger@1"
        },
        {
          "command": "teamflow.deleteScratchOrg",
          "when": "view == teamflow.orgs && viewItem == teamflow.org",
          "group": "9_danger@2"
        }
      ],
      "commandPalette": [
        {
          "command": "teamflow.setDefaultOrg",
          "when": "false"
        },
        {
          "command": "teamflow.openOrg",
          "when": "false"
        },
        {
          "command": "teamflow.logoutOrg",
          "when": "false"
        },
        {
          "command": "teamflow.copyOrgId",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "SF TeamFlow",
      "properties": {
        "teamflow.deploy.baseRef": {
          "type": "string",
          "default": "origin/main",
          "description": "Git差分デプロイの基準となるref (例: origin/main, develop)。sf-teamflow.json の環境設定があればそちらが優先されます。"
        },
        "teamflow.deploy.testLevel": {
          "type": "string",
          "enum": [
            "NoTestRun",
            "RunSpecifiedTests",
            "RunLocalTests",
            "RunAllTestsInOrg"
          ],
          "default": "RunLocalTests",
          "description": "デプロイ/検証時のApexテストレベル。"
        },
        "teamflow.confirmProductionDeploy": {
          "type": "boolean",
          "default": true,
          "description": "本番Orgへのデプロイ前に確認ダイアログを表示する。"
        },
        "teamflow.sfCliPath": {
          "type": "string",
          "default": "sf",
          "description": "Salesforce CLI (sf) の実行パス。PATHが通っていない場合に絶対パスを指定。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "test": "node --test out-test/test",
    "compile-test": "tsc -p tsconfig.test.json",
    "pretest": "npm run compile-test",
    "lint": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
